# Template: install.sh replaces @PROGRAM@ with PROGRAM_DIR/diskwarden.sh
# (PROGRAM_DIR is set in /etc/diskwarden/diskwarden.conf).
[Unit]
Description=diskwarden - mount configured disks on arrival, unmount on flag removal
Documentation=file:/usr/share/doc/diskwarden/README.md
After=local-fs.target systemd-udevd.service
Wants=systemd-udevd.service

[Service]
Type=simple
# Run through bash so the script works under SELinux whatever the label of
# PROGRAM_DIR (the service then runs as unconfined_service_t).
ExecStartPre=/usr/bin/bash @PROGRAM@ --check
ExecStart=/usr/bin/bash @PROGRAM@
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# IMPORTANT: do not add PrivateTmp=, ProtectSystem=, ProtectHome=,
# PrivateMounts= or similar sandboxing options. They give the service its own
# mount namespace, and the disks it mounts would be invisible to the system.

[Install]
WantedBy=multi-user.target
